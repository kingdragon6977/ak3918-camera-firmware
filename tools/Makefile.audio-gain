CROSS ?= arm-linux-gnueabi-
CC := $(CROSS)gcc
CFLAGS ?= -Os -fPIC -Wall -Wextra
LDFLAGS ?= -shared -Wl,-soname,libak_audio_gain.so
VOLUME ?= 5
SRC := tools/ak_audio_gain.c
OUT := tools/libak_audio_gain.so

.PHONY: all clean
all: $(OUT)

$(OUT): $(SRC)
	$(CC) $(CFLAGS) -DAK_FIXED_AI_VOLUME=$(VOLUME) $(LDFLAGS) -o $@ $<

clean:
	rm -f $(OUT)
